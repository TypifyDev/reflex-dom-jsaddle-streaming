cabal-version:      2.4
name:               reflex-dom-jsaddle-streaming
version:            0.1.0.0
synopsis:           Reflex FRP shapes over servant-jsaddle progressive streaming
description:
  Four reusable functions that bridge
  'Servant.Client.JSaddle.Streaming.sendStreamingRequest' (the
  JSaddle-native XHR callback primitive) into different Reflex shapes
  (per-message Event, one-shot complete Event, live Dynamic of
  accumulated state, cumulative Dynamic of all values). All four are
  polymorphic in the parsed message type; pass a
  @ByteString -> Maybe v@ parser to control decoding. The framing
  assumed on the wire is newline-delimited
  (servant\'s @NewlineFraming@).
license:            BSD-3-Clause
author:             you
maintainer:         you
build-type:         Simple

library
  hs-source-dirs:     src
  default-language:   Haskell2010
  ghc-options:        -Wall
  exposed-modules:
      Reflex.Dom.JSaddleStreaming
  build-depends:
      base                  >= 4.14 && < 5
    , bytestring
    , jsaddle
    , mtl
    , reflex
    , servant-client-core
    , servant-jsaddle
    , text
