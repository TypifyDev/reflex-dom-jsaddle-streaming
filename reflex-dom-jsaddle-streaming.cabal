cabal-version:      2.4
name:               reflex-dom-jsaddle-streaming
version:            0.1.0.0
synopsis:           Reflex FRP shapes over servant-jsaddle progressive streaming
description:
  Four reusable functions that bridge a typed servant streaming call —
  @ClientM (SourceIO v)@ — into different Reflex shapes:
  per-value 'Event', one-shot complete-list 'Event', live 'Dynamic' of
  accumulated state, and cumulative 'Dynamic' list. Framing and
  decoding come from servant's 'FramingUnrender' + 'MimeUnrender'
  instances via the API type; no manual parser argument required.
  .
  Built on top of servant-jsaddle\'s progressive 'RunStreamingClient'
  instance, which bridges the async XHR push model into 'SourceIO''s
  sync-pull model.
license:            BSD-3-Clause
author:             you
maintainer:         you
build-type:         Simple

library
  hs-source-dirs:     src
  default-language:   Haskell2010
  ghc-options:        -Wall
  exposed-modules:
      Reflex.Dom.JSaddleStreaming
  build-depends:
      base                  >= 4.14 && < 5
    , ghcjs-dom
    , jsaddle
    , mtl
    , reflex
    , servant
    , servant-jsaddle
    , text
